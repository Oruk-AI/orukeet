+struct test_pos_projection_cache : public test_relative_shift_view {
+    test_pos_projection_cache(int64_t length, int64_t features)
+        : test_relative_shift_view(length, features, 1) {}
+    std::string op_desc(ggml_tensor *) override { return "POS_PROJECTION_CACHE"; }
+    std::string vars() override { return "length=" + std::to_string(length) + ",features=" + std::to_string(heads); }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t features = heads;
+        auto pe = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, features, 1023);
+        auto weight = ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, features, features);
+        auto cached = ggml_mul_mat(ctx, weight, pe);
+        const size_t start = (1023 - length)/2;
+        auto input_view = ggml_view_2d(ctx, pe, features, length, pe->nb[1], start*pe->nb[1]);
+        auto direct = ggml_mul_mat(ctx, weight, input_view);
+        auto cached_view = ggml_view_2d(ctx, cached, features, length, cached->nb[1], start*cached->nb[1]);
+        return ggml_sub(ctx, direct, cached_view);
+    }
+};
