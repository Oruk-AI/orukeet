+// Compare the relative-shift view with the pad/reshape/crop construction.
+// Both backends must produce an exactly zero difference, not just agree on it.
+struct test_relative_shift_view : public test_case {
+    const int64_t length;
+    const int64_t heads;
+    const int64_t batch;
+
+    test_relative_shift_view(int64_t length, int64_t heads, int64_t batch)
+        : length(length), heads(heads), batch(batch) {}
+    std::string op_desc(ggml_tensor *) override { return "RELATIVE_SHIFT_VIEW"; }
+    std::string vars() override { return VARS_TO_STR3(length, heads, batch); }
+    bool run_whole_graph() override { return true; }
+    double max_nmse_err() override { return 0.0; }
+    double err(const float * a, const float * b, size_t n) override {
+        double result = 0;
+        for (size_t i = 0; i < n; ++i) result = std::max(result, double(std::max(std::abs(a[i]), std::abs(b[i]))));
+        return result;
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        auto source = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 2*length - 1, length, heads, batch);
+        auto row = ggml_view_4d(ctx, source, 1, length, heads, batch,
+            source->nb[1], source->nb[2], source->nb[3], 0);
+        auto zero = ggml_scale(ctx, ggml_cont(ctx, row), 0.0f);
+        auto padded = ggml_concat(ctx, zero, source, 0);
+        auto reshaped = ggml_reshape_4d(ctx, padded, length, 2*length, heads, batch);
+        auto cropped = ggml_view_4d(ctx, reshaped, length, 2*length - 1, heads, batch,
+            reshaped->nb[1], reshaped->nb[2], reshaped->nb[3], reshaped->nb[1]);
+        auto shifted = ggml_reshape_4d(ctx, ggml_cont(ctx, cropped), 2*length - 1, length, heads, batch);
+        auto reference = ggml_view_4d(ctx, shifted, length, length, heads, batch,
+            shifted->nb[1], shifted->nb[2], shifted->nb[3], 0);
+        auto view = ggml_view_4d(ctx, source, length, length, heads, batch,
+            source->nb[1] - sizeof(float), source->nb[2], source->nb[3], (length - 1)*sizeof(float));
+        return ggml_sub(ctx, ggml_cont(ctx, view), reference);
+    }
+};
+
+// Q/K/P matrix products accept rows interleaved across attention heads; V's
+// transpose can gather directly from the QKV tensor. Compare with staging.
+struct test_attention_input_views : public test_relative_shift_view {
+    using test_relative_shift_view::test_relative_shift_view;
+    std::string op_desc(ggml_tensor *) override { return "ATTENTION_INPUT_VIEWS"; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t dk = 128;
+        const int64_t features = dk*heads;
+        auto qkv = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 3*features, length, batch);
+        auto slice = [&](int index) {
+            auto view = ggml_view_4d(ctx, qkv, dk, heads, length, batch,
+                dk*sizeof(float), qkv->nb[1], qkv->nb[2], index*features*sizeof(float));
+            return ggml_permute(ctx, view, 0, 2, 1, 3);
+        };
+        auto q = slice(0);
+        auto k = slice(1);
+        auto v = slice(2);
+        auto pos = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, dk, heads, 2*length - 1);
+        auto p = ggml_permute(ctx, pos, 0, 2, 1, 3);
+        auto bias = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, dk, 1, heads, 1);
+        auto ref_q = ggml_add(ctx, ggml_cont(ctx, q), bias);
+        auto fast_q = ggml_add(ctx, q, bias);
+        auto ref_ac = ggml_mul_mat(ctx, ggml_cont(ctx, k), ref_q);
+        auto fast_ac = ggml_mul_mat(ctx, k, fast_q);
+        auto ref_bd = ggml_mul_mat(ctx, ggml_cont(ctx, p), ref_q);
+        auto fast_bd = ggml_mul_mat(ctx, p, fast_q);
+        auto ref_v = ggml_cont(ctx, ggml_permute(ctx, ggml_cont(ctx, v), 1, 0, 2, 3));
+        auto fast_v = ggml_cont(ctx, ggml_permute(ctx, v, 1, 0, 2, 3));
+        auto flatten_diff = [&](ggml_tensor * a, ggml_tensor * b) {
+            auto diff = ggml_sub(ctx, a, b);
+            return ggml_reshape_1d(ctx, diff, ggml_nelements(diff));
+        };
+        return ggml_concat(ctx, ggml_concat(ctx, flatten_diff(fast_ac, ref_ac),
+            flatten_diff(fast_bd, ref_bd), 0), flatten_diff(fast_v, ref_v), 0);
+    }
+};
