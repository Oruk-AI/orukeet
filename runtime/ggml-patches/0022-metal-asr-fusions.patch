+        out = ggml_concat(ctx, h, c, 0);
+        if (mode == 1) ggml_set_output(ig);
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_case::initialize_tensors(ctx);
+        if (reordered) {
+            auto nodes = ggml_graph_nodes(gf);
+            const int count = ggml_graph_n_nodes(gf);
+            auto fc_at = std::find(nodes, nodes + count, fc_node);
+            auto copy_at = std::find(nodes, nodes + count, i_copy);
+            GGML_ASSERT(fc_at < copy_at && copy_at < nodes + count);
+            std::rotate(fc_at, fc_at + 1, copy_at + 1);
+        }
+        if (mode < 2) return;
+        GGML_ASSERT(batch == 1);
+        h->buffer = gates->buffer;
+        h->data = (char *) gates->data + (mode == 3 ? sizeof(float) : 0);
+        if (mode == 2) {
+            c->buffer = gates->buffer;
+            c->data = (char *) gates->data + hidden*sizeof(float);
+        }
+    }
