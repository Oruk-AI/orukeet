diff --git a/src/ggml-metal/ggml-metal.metal b/src/ggml-metal/ggml-metal.metal
index 55ad5ea..c9f1d43 100644
--- a/src/ggml-metal/ggml-metal.metal
+++ b/src/ggml-metal/ggml-metal.metal
@@ -4696,6 +4696,35 @@ kernel void kernel_im2col(
 template [[host_name("kernel_im2col_f32")]] kernel im2col_t kernel_im2col<float>;
 template [[host_name("kernel_im2col_f16")]] kernel im2col_t kernel_im2col<half>;
 
+template <typename T>
+kernel void kernel_im2col_flat(
+        constant ggml_metal_kargs_im2col_flat & flat,
+        device const float * x,
+        device T * dst,
+        uint index [[thread_position_in_grid]]) {
+    if (index >= flat.n) return;
+    constant auto & args = flat.base;
+    const uint element = index % uint(args.CHW);
+    const uint spatial = index / uint(args.CHW);
+    const uint channel = element / uint(args.KHW);
+    const uint kh = (element % uint(args.KHW)) / uint(args.KW);
+    const uint kw = element % uint(args.KW);
+    const uint ow = spatial % flat.OW;
+    const uint oh = (spatial / flat.OW) % flat.OH;
+    const uint batch = spatial / (flat.OW * flat.OH);
+    const int iw = int(ow)*args.s0 + int(kw)*args.d0 - args.p0;
+    const int ih = int(oh)*args.s1 + int(kh)*args.d1 - args.p1;
+    if (iw < 0 || iw >= args.IW || ih < 0 || ih >= args.IH) {
+        dst[index] = T(0);
+    } else {
+        const uint64_t offset = batch*args.ofs0 + channel*args.ofs1 + uint64_t(ih)*args.IW + iw;
+        dst[index] = T(x[offset]);
+    }
+}
+
+template [[host_name("kernel_im2col_flat_f32")]] kernel decltype(kernel_im2col_flat<float>) kernel_im2col_flat<float>;
+template [[host_name("kernel_im2col_flat_f16")]] kernel decltype(kernel_im2col_flat<half>) kernel_im2col_flat<half>;
+
 // TODO: obsolete -- remove
 //typedef void (im2col_ext_t)(
 //        constant ggml_metal_kargs_im2col & args,
@@ -7351,6 +7380,38 @@ kernel void kernel_cpy_t_t(
     }
 }
 
+kernel void kernel_cpy_f32_dense(
+        constant ggml_metal_kargs_cpy & args,
+        device const float * src,
+        device float * dst,
+        uint index [[thread_position_in_grid]]) {
+    const uint n = uint(args.ne00)*uint(args.ne01)*uint(args.ne02)*uint(args.ne03);
+    if (index >= n/4 + uint(n%4 != 0)) return;
+    const uint i = index*4;
+    if (i >= n) return;
+    if (n - i >= 4) {
+        ((device float4 *) dst)[index] = ((device const float4 *) src)[index];
+    } else {
+        for (uint j = i; j < n; ++j) dst[j] = src[j];
+    }
+}
+
+kernel void kernel_cpy_f32_flat(
+        constant ggml_metal_kargs_cpy & args,
+        device const char * src,
+        device float * dst,
+        uint index [[thread_position_in_grid]]) {
+    const uint n = uint(args.ne00)*uint(args.ne01)*uint(args.ne02)*uint(args.ne03);
+    if (index >= n) return;
+    uint remaining = index;
+    const uint i0 = remaining % uint(args.ne00); remaining /= uint(args.ne00);
+    const uint i1 = remaining % uint(args.ne01); remaining /= uint(args.ne01);
+    const uint i2 = remaining % uint(args.ne02);
+    const uint i3 = remaining / uint(args.ne02);
+    const uint64_t offset = i0*args.nb00 + i1*args.nb01 + i2*args.nb02 + i3*args.nb03;
+    dst[index] = *(device const float *)(src + offset);
+}
+
 typedef decltype(kernel_cpy_t_t<float, float>) kernel_cpy_t;
 
 template [[host_name("kernel_cpy_f32_f32")]]   kernel kernel_cpy_t kernel_cpy_t_t<float,   float>;
